# --- Base de données (PostgreSQL) ---
# gb10 (betadev) puis Jelastic (prod)
DATABASE_URL="postgresql://ticketick:ticketick@localhost:5432/ticketick?schema=public"

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Dossier des images uploadées (couvertures, logos). En Docker : /app/data/uploads
# UPLOAD_DIR=""
# betadev: https://appbetadev.ticketick.ch
# prod:     https://ticketick.ch

# --- Authentification (Auth.js) ---
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# --- Secrets des prestataires (encaissement des organisateurs) ---
# Chiffre en base les secrets saisis dans l'admin. Facultatif : à défaut,
# AUTH_SECRET sert de clé. Changer l'une ou l'autre oblige à ressaisir les
# secrets PostFinance et PayPal dans /admin/payments.
# PAYMENT_SECRETS_KEY=""

# --- Paiement simulé ---
# Solde la commande et émet les billets sans encaisser un centime. Réservé aux
# environnements d'essai : sans cette autorisation explicite, une clé Stripe
# absente fait échouer le paiement au lieu d'offrir des billets gratuits.
ALLOW_MOCK_PAYMENTS="false"

# --- PostFinance Checkout ---
# Chaque organisateur encaisse sur son propre espace, saisi dans
# /admin/payments. Les valeurs ci-dessous ne servent qu'une fois : au
# déploiement, elles deviennent l'espace d'Illyria s'il n'en a pas encore.
# Sans espace (ni IBAN, ni PayPal), l'acheteur va jusqu'au paiement et lit
# « paiement pas encore activé » — sauf ALLOW_MOCK_PAYMENTS=true (simulé).
PF_CHECKOUT_SPACE_ID=""
PF_CHECKOUT_USER=""
PF_CHECKOUT_SECRET=""
# Facultatif : identifiant d'une Space View / page de paiement dédiée.
PF_CHECKOUT_SPACE_VIEW_ID=""
# Nom de l'application annoncé à PostFinance (défaut : ticketick).
PF_CHECKOUT_APP_NAME=""
# Webhook à créer dans l'espace de CHAQUE organisateur (entité Transaction,
# nom pf_paid) :
#   https://appbetadev.ticketick.ch/api/webhooks/postfinance (betadev)
#   https://ticketick.ch/api/webhooks/postfinance (prod)

# --- Stripe (facturation des organisateurs, pas les billets) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- E-mail (SMTP) ---
# Laisser vide pour journaliser les e-mails en console (dev). Le lien de
# réinitialisation de mot de passe apparaît alors dans la sortie du serveur :
# c'est le seul moyen de le récupérer sans boîte aux lettres.
# En production, l'absence de SMTP rend toute récupération de compte
# impossible — la demande répond « lien envoyé » sans que rien ne parte.
# Port 465 : TLS d'emblée. Port 587 : STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ticketick <ticket@ticketick.ch>"
# Destinataire des candidatures organisateur. Par défaut : info@ticketick.ch.
MAIL_TO="info@ticketick.ch"

# --- Import de plan de salle : lecture de la légende par l'IA ---
# aimanager (GB10), compatible OpenAI. Sans ces deux valeurs, l'import reste
# complet mais les catégories sont à nommer à la main.
LITELLM_API_URL=""
LITELLM_API_KEY=""
# PLAN_AI_MODEL="ollama_chat/gemma4:12b"
