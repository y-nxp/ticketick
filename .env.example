# --- Base de données (PostgreSQL) ---
# gb10 (betadev) puis Jelastic (prod)
DATABASE_URL="postgresql://ticketick:ticketick@localhost:5432/ticketick?schema=public"

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# betadev: https://appbetadev.ticketick.ch
# prod:     https://ticketick.ch

# --- Authentification (Auth.js) ---
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# --- Paiement simulé ---
# Solde la commande et émet les billets sans encaisser un centime. Réservé aux
# environnements d'essai : sans cette autorisation explicite, une clé Stripe
# absente fait échouer le paiement au lieu d'offrir des billets gratuits.
ALLOW_MOCK_PAYMENTS="false"

# --- Stripe (paiement par carte) ---
# Vide + ALLOW_MOCK_PAYMENTS=true : mode simulé. Vide en production : le
# paiement par carte est refusé (HTTP 503).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Endpoint du webhook à configurer dans Stripe :
#   https://appbetadev.ticketick.ch/api/webhooks/stripe (betadev)
#   https://ticketick.ch/api/webhooks/stripe (prod)

# --- E-mail (SMTP) ---
# Laisser vide pour journaliser les e-mails en console (dev). Le lien de
# réinitialisation de mot de passe apparaît alors dans la sortie du serveur :
# c'est le seul moyen de le récupérer sans boîte aux lettres.
# En production, l'absence de SMTP rend toute récupération de compte
# impossible — la demande répond « lien envoyé » sans que rien ne parte.
# Port 465 : TLS d'emblée. Port 587 : STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ticketick <billets@ticketick.ch>"
# Destinataire des candidatures organisateur. Par défaut : info@ticketick.ch.
MAIL_TO="info@ticketick.ch"

# --- Virement IBAN (compte de l'organisateur) ---
# Envoyées telles quelles à l'acheteur. Sans elles, le virement est refusé
# plutôt que de renvoyer l'IBAN d'exemple ci-dessous, qui n'encaisse rien.
BANK_IBAN="CH93 0076 2011 6238 5295 7"
BANK_BENEFICIARY="ticketick SA, Lausanne"
