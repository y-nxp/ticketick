// ticketick — schéma de données
// Billetterie suisse. PostgreSQL.
//
// Principe structurant : un Event est l'œuvre (titre, description, visuel,
// catégories) ; une EventSession est une représentation datée de cette œuvre
// (date, lieu, plan de salle, inventaire, tarifs). Un événement à date unique
// a simplement une seule session.
//
// Les montants sont toujours en centimes (Int) et les taux en points de base
// (250 = 2,50 %) : jamais de Float sur de l'argent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ORGANIZER
  RESELLER_AGENT
  /// Contrôleur à l'entrée : scanner uniquement, aucun accès au backoffice.
  DOOR_STAFF
  /// Responsable invité par un organisateur : consulte ses ventes, ne modifie rien.
  ORGANIZER_VIEWER
  ADMIN
}

/// Session ouverte par une connexion réussie.
///
/// Conservée en base plutôt que portée entièrement par le cookie : c'est ce
/// qui permet de révoquer un accès. Un jeton auto-porteur resterait valable
/// jusqu'à son échéance même après la désactivation du compte.
model Session {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  expiresAt DateTime

  /// Contexte de la connexion, pour qu'un utilisateur reconnaisse ses propres
  /// sessions dans la liste de ses appareils.
  userAgent String?
  ipAddress String?

  /// Administrateur qui consulte le compte : la session appartient à
  /// l'organisateur, le retour se fait via cet identifiant.
  impersonator   User?   @relation("SessionImpersonator", fields: [impersonatorId], references: [id], onDelete: SetNull)
  impersonatorId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Jeton de réinitialisation de mot de passe, à usage unique.
///
/// Seule l'empreinte du jeton est conservée : la valeur en clair ne vit que
/// dans le lien envoyé par courriel. Une fuite de la base ne permettrait donc
/// pas de prendre la main sur les comptes dont une demande est en cours.
/// Lien de confirmation d'adresse, même principe que la réinitialisation :
/// seule l'empreinte du jeton est conservée.
model EmailVerificationToken {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// SHA-256 du jeton transmis, en hexadécimal.
  tokenHash String   @unique
  expiresAt DateTime

  /// Horodatage de l'emploi. Non supprimée aussitôt : conserver la ligne
  /// permet de distinguer un lien déjà utilisé d'un lien qui n'a jamais existé.
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Candidature organisateur. Personne ne s'inscrit tout seul : la demande
/// arrive ici, un rendez-vous est proposé à la main, les accès sont ouverts
/// ensuite depuis le compte administrateur.
enum InquiryFormat {
  ONE_DAY
  MULTI_DAY
  MULTI_SESSION
  UNSURE
}

model OrganizerInquiry {
  id      String        @id @default(cuid())
  email   String
  phone   String
  format  InquiryFormat
  message String?
  locale  String        @default("fr")

  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  SOLD_OUT
  PAST
}

/// Portée de diffusion. MEMBERS couvre le besoin des organisateurs
/// d'entreprise qui réservent un événement à leur communauté.
enum EventVisibility {
  PUBLIC
  UNLISTED
  MEMBERS
}

/// Prix d'une option de commande : montant unique, ou par choix coché.
enum EventOptionPriceMode {
  FLAT
  PER_CHOICE
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  IBAN
  CASH
  PAYPAL
  /// Commande à 0 fr. : validée sans encaissement.
  FREE
  /// Places réservées depuis l'admin, sans encaissement sur ticketick.
  RESERVATION
  /// Carte encaissée sur le terminal d'un point de vente.
  TERMINAL
}

/// État d'un siège numéroté pour une séance.
enum SeatStatus {
  AVAILABLE
  /// Pris par une commande (rétention, virement attendu ou payée).
  RESERVED
  /// Retiré de la vente à la main (invités, régie, presse).
  BLOCKED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  PENDING
}

/// Canal par lequel la commande a été passée.
enum SalesChannel {
  ONLINE
  RESELLER
  BOX_OFFICE
}

enum ResellerType {
  TOURISM_OFFICE
  PARTNER_SHOP
  BOX_OFFICE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountScope {
  ORDER
  EVENT
  SESSION
  TICKET_TYPE
}

/// Sens de l'écriture au grand livre revendeur.
enum LedgerEntryType {
  COMMISSION_EARNED
  CASH_COLLECTED
  SETTLEMENT
  ADJUSTMENT
}

enum SettlementStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         UserRole @default(CUSTOMER)
  locale       String   @default("fr")
  phone        String?

  /// Un compte désactivé conserve son historique mais ne peut plus se
  /// connecter : on ne supprime pas un utilisateur rattaché à des commandes.
  active      Boolean   @default(true)
  lastLoginAt DateTime?

  /// Adresse prouvée par un lien reçu. Tant qu'elle ne l'est pas, les achats
  /// faits sans compte sous cette adresse restent inaccessibles : n'importe
  /// qui peut s'inscrire avec l'e-mail d'un autre.
  emailVerifiedAt DateTime?

  sessions           Session[]
  impersonations     Session[]                @relation("SessionImpersonator")
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  /// Accès "amis du festival" (session PWA)
  isFestivalFriend Boolean @default(false)

  organizer Organizer?

  /// Contrôleur : organisateur dont il scanne les billets. Vide, il contrôle
  /// les spectacles de tous les organisateurs.
  doorOrganizer   Organizer? @relation("DoorStaff", fields: [doorOrganizerId], references: [id], onDelete: SetNull)
  doorOrganizerId String?

  /// Responsable invité : organisateur dont il consulte les ventes.
  statsOrganizer   Organizer? @relation("StatsViewers", fields: [statsOrganizerId], references: [id], onDelete: SetNull)
  statsOrganizerId String?

  /// Renseigné pour les agents d'un point de vente revendeur.
  reseller   Reseller? @relation(fields: [resellerId], references: [id])
  resellerId String?

  orders     Order[]
  soldOrders Order[] @relation("OrderSoldBy")

  /// Offres des organisateurs suivis. Jamais implicite : case décochée
  /// à l'inscription, révocable depuis le compte.
  marketingOptIn   Boolean           @default(false)
  marketingOptInAt DateTime?
  follows          OrganizerFollow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resellerId])
  @@index([doorOrganizerId])
  @@index([statsOrganizerId])
}

model Organizer {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  email       String
  /// Présentation de la page `/go/…` : { fr, en, de, it, es? }.
  description Json?
  logoUrl     String?
  website     String?

  /// Charte de la page hébergée (`/go/…`) et du widget : boutons, titres, fond.
  brandPrimary String?
  brandAccent  String?
  brandBg      String?
  /// Jour ou nuit de la page `/go/…`, indépendant du thème ticketick du visiteur.
  brandScheme  String  @default("light")
  /// Menu vers le site de l'organisateur : [{ "label": "Accueil", "href": "https://…" }]
  navLinks     Json?

  /// Copies des billets émis, une adresse par ligne dans l'admin.
  notifyEmails String[] @default([])

  /// Responsable légal imprimé sur les billets. Si vide : pied ticketick seul.
  producerName     String?
  producerUrl      String?
  producerLogoUrl  String?
  /// CG du billet { fr, en, de, it }. Si vide : conditions ticketick.ch/terms.
  ticketDisclaimer Json?

  /// Active la PWA "amis du festival" pour cet organisateur
  friendsAppEnabled Boolean @default(false)

  /// Compte qui reçoit les virements des acheteurs. Vide : pas de virement.
  bankIban        String?
  bankBeneficiary String?

  /// Prestataire qui encaisse la carte quand PostFinance et Stripe sont
  /// tous deux actifs : "postfinance" | "stripe". Vide : PostFinance.
  cardProvider String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  events       Event[]
  followers    OrganizerFollow[]
  doorStaff    User[]                       @relation("DoorStaff")
  statsViewers User[]                       @relation("StatsViewers")
  discounts    Discount[]
  resellers    Reseller[]
  paypal       OrganizerPaypalAccount?
  postfinance  OrganizerPostfinanceAccount?
  stripe       OrganizerStripeAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Espace PostFinance Checkout sur lequel l'organisateur encaisse les cartes.
/// Chacun le sien : un paiement ne doit jamais arriver chez un autre.
/// Le secret n'est stocké que chiffré, comme celui de PayPal.
model OrganizerPostfinanceAccount {
  id          String    @id @default(cuid())
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId String    @unique
  spaceId     Int
  userId      Int
  secretEnc   String
  /// Page de paiement dédiée, facultative.
  spaceViewId Int?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Compte Stripe sur lequel l'organisateur encaisse les cartes (paiement
/// direct sur son compte, sans Stripe Connect). Clé secrète et secret du
/// webhook ne sont stockés que chiffrés.
model OrganizerStripeAccount {
  id                String    @id @default(cuid())
  organizer         Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId       String    @unique
  /// Identifiant du compte (acct_…) lu avec la clé.
  accountId         String
  accountName       String?
  secretEnc         String
  /// Déduit de la clé : sk_live_/rk_live_ ou clé de test.
  live              Boolean
  /// Webhook créé par ticketick dans le compte Stripe. Vide : le paiement
  /// n'est constaté qu'au retour de l'acheteur.
  webhookEndpointId String?
  webhookSecretEnc  String?
  enabled           Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Compte PayPal Business sur lequel l'organisateur encaisse.
///
/// Le secret n'est stocké que chiffré (AES-256-GCM, clé hors base) : une
/// copie de la base ne suffit pas à rembourser ni à encaisser à sa place.
model OrganizerPaypalAccount {
  id          String    @id @default(cuid())
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId String    @unique
  /// Adresse du compte qui reçoit les paiements.
  payeeEmail  String
  clientId    String
  secretEnc   String
  /// `false` : environnement de test PayPal (sandbox).
  live        Boolean   @default(true)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Un spectateur ne reçoit les offres que des organisateurs qu'il suit.
model OrganizerFollow {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId String
  createdAt   DateTime  @default(now())

  @@unique([userId, organizerId])
  @@index([organizerId])
}

model Category {
  id     String  @id @default(cuid())
  slug   String  @unique
  /// Traductions du nom { fr, en, de, it }
  name   Json
  color  String  @default("#6C5CE7")
  icon   String?
  events Event[] @relation("EventCategories")
}

model Venue {
  id      String  @id @default(cuid())
  name    String
  address String?
  city    String
  canton  String?
  country String  @default("CH")
  zip     String?
  /// Coordonnées facultatives : une session sans lat/lng n'affiche pas de carte.
  lat     Float?
  lng     Float?

  sessions  EventSession[]
  seatPlans SeatPlan[]
  discounts Discount[]
}

/// L'œuvre. Ne porte ni date, ni lieu, ni inventaire : tout cela vit
/// sur ses sessions.
model Event {
  id          String          @id @default(cuid())
  slug        String          @unique
  /// Traductions { fr, en, de, it }
  title       Json
  description Json
  status      EventStatus     @default(DRAFT)
  visibility  EventVisibility @default(PUBLIC)
  featured    Boolean         @default(false)
  coverImage  String?
  gallery     String[]        @default([])
  /// Étiquettes affichées sur la carte et la fiche (« Grands duos, Bel canto ») :
  /// traductions { fr, en, de, it, es }, séparées par des virgules.
  tags        Json?

  /// Moyens d'encaissement proposés par défaut à toutes les séances.
  acceptCard   Boolean @default(true)
  acceptIban   Boolean @default(true)
  /// Encaissement sur le compte PayPal de l'organisateur.
  acceptPaypal Boolean @default(false)

  /// Faux : aucune vente sur ticketick (conférence, entrée sur inscription).
  /// La fiche renvoie vers le courriel, le téléphone ou le site ci-dessous.
  onlineSale   Boolean @default(true)
  contactEmail String?
  contactPhone String?
  contactUrl   String?
  /// Remplace la phrase d'introduction, ex. « Billetterie auprès du Gstaad Yacht Club ».
  contactNote  Json?

  organizer   Organizer @relation(fields: [organizerId], references: [id])
  organizerId String

  /// Facultatif : un événement peut n'avoir aucune catégorie.
  categories Category[] @relation("EventCategories")

  sessions  EventSession[]
  discounts Discount[]
  resellers ResellerEvent[]
  options   EventOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, visibility])
  @@index([organizerId])
}

/// Une représentation datée. Un événement à date unique en a exactement une.
model EventSession {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// Libellé facultatif pour distinguer les séances ("Première", "Matinée").
  label Json?

  startsAt DateTime
  endsAt   DateTime?
  doorsAt  DateTime?

  status EventStatus @default(PUBLISHED)

  /// Facultatif : certaines sessions n'ont pas de lieu physique renseigné.
  venue   Venue?  @relation(fields: [venueId], references: [id])
  venueId String?

  /// Plan de salle facultatif : placement libre si absent.
  seatPlan   SeatPlan?     @relation(fields: [seatPlanId], references: [id])
  seatPlanId String?
  seats      SessionSeat[]

  /// Jauge de la salle pour cette séance, toutes catégories confondues.
  /// Absente : seuls les contingents de chaque tarif limitent la vente.
  capacity Int?
  /// Places déjà retenues (tous tarifs). Sert à faire respecter `capacity`.
  sold     Int  @default(0)
  /// Placement libre : places mises de côté pour les invités, en plus de `capacity`.
  /// Une réservation « invités » les fait passer dans la jauge.
  inviteSeats Int @default(0)

  /// Surcharge les moyens du spectacle. `null` = on hérite.
  acceptCard Boolean?
  acceptIban Boolean?

  ticketTypes TicketType[]
  discounts   Discount[]
  options     EventOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, startsAt])
  @@index([startsAt, status])
}

/// Plan de salle numéroté, propre à un lieu et partagé par ses séances.
model SeatPlan {
  id      String @id @default(cuid())
  /// Clé stable du plan dans le code (`rougemont-eglise`).
  slug    String @unique
  name    String
  venue   Venue  @relation(fields: [venueId], references: [id])
  venueId String
  /// `SeatLayout` : zones, sections, sièges et coordonnées (lib/seating).
  layout  Json

  sessions EventSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

/// État d'un siège pour une séance : une ligne par siège du plan.
model SessionSeat {
  id        String       @id @default(cuid())
  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  seatKey   String
  zone      String
  status    SeatStatus   @default(AVAILABLE)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  /// Motif d'un blocage (« Invité artiste », « Presse »…).
  blockNote String?
  updatedAt DateTime     @updatedAt

  @@unique([sessionId, seatKey])
  @@index([sessionId, status])
  @@index([orderId])
}

/// Inventaire et tarif, rattachés à une session précise.
model TicketType {
  id               String       @id @default(cuid())
  session          EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId        String
  name             Json // { fr, en, de, it }
  description      Json?
  priceCents       Int
  currency         String       @default("CHF")
  quantity         Int
  sold             Int          @default(0)
  maxPerOrder      Int          @default(10)
  /// Si renseigné, ce tarif n'est vendu qu'avec des billets payants de la
  /// même séance : au plus N de ces places par billet payant.
  maxPerPaidTicket Int?
  /// Tarif payant qui débloque ces places. Absent : tous les payants de la
  /// séance comptent. Renseigné : seule la zone visée compte.
  companionOfId    String?
  companionOf      TicketType?  @relation("Companion", fields: [companionOfId], references: [id], onDelete: SetNull)
  companions       TicketType[] @relation("Companion")

  /// Séance numérotée : zones du plan où ce tarif se vend. Vide = toutes.
  seatZones        String[] @default([])
  /// Nom complet et date de naissance exigés pour chaque billet.
  requiresAttendee Boolean  @default(false)
  /// Âge maximal (exclu) le jour de la séance : 25 = moins de 25 ans.
  maxAgeYears      Int?

  salesStartAt DateTime?
  salesEndAt   DateTime?

  orderItems OrderItem[]
  tickets    Ticket[]
  discounts  Discount[]

  @@index([sessionId])
  @@index([companionOfId])
}

/// Point de vente tiers : office du tourisme, boutique partenaire, guichet.
model Reseller {
  id      String       @id @default(cuid())
  slug    String       @unique
  name    String
  type    ResellerType @default(TOURISM_OFFICE)
  email   String
  phone   String?
  address String?
  city    String?
  /// Langue du récapitulatif envoyé par e-mail.
  locale  String       @default("fr")

  /// Organisateur qui l'a créé, seul à le gérer avec l'admin. Vide : créé par
  /// l'admin, il peut vendre les spectacles de plusieurs organisateurs.
  organizer   Organizer? @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId String?

  /// Commission par défaut, modifiable par spectacle attribué.
  commissionKind       CommissionKind @default(PERCENT)
  /// Pourcentage, en points de base (250 = 2,50 %).
  commissionBps        Int            @default(0)
  /// Montant fixe par billet payant vendu.
  commissionFixedCents Int            @default(0)

  /// Espèces et terminal : l'argent reste au point de vente, qui le doit à l'organisateur.
  allowCashSales     Boolean @default(true)
  allowTerminalSales Boolean @default(true)
  /// Carte en ligne de l'organisateur : le client paie sur l'écran ou par QR.
  allowOnlineSales   Boolean @default(true)

  /// Copies des e-mails de vente et récapitulatifs, une adresse par ligne.
  notifyEmails        String[]        @default([])
  reportFrequency     ReportFrequency @default(NONE)
  /// Le récapitulatif part aussi aux adresses de copie de l'organisateur.
  reportCopyOrganizer Boolean         @default(true)
  /// Fin de la période du dernier récapitulatif envoyé.
  lastReportAt        DateTime?

  active Boolean @default(true)

  agents      User[]
  orders      Order[]
  events      ResellerEvent[]
  ledger      ResellerLedgerEntry[]
  settlements ResellerSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
}

enum CommissionKind {
  PERCENT
  FIXED_PER_TICKET
}

enum ReportFrequency {
  NONE
  DAILY
  WEEKLY
}

/// Spectacle qu'un point de vente a le droit de vendre. Commission vide :
/// celle du point de vente.
model ResellerEvent {
  id         String   @id @default(cuid())
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  resellerId String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String

  commissionKind       CommissionKind?
  commissionBps        Int?
  commissionFixedCents Int?

  createdAt DateTime @default(now())

  @@unique([resellerId, eventId])
  @@index([eventId])
}

/// Grand livre d'un revendeur. Montants signés **du point de vue du revendeur** :
/// positif = ticketick lui doit, négatif = il doit à ticketick.
/// Son solde est la somme des écritures, ce qui rend le calcul auditable.
model ResellerLedgerEntry {
  id         String   @id @default(cuid())
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  resellerId String

  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?

  type        LedgerEntryType
  amountCents Int
  note        String?

  createdAt DateTime @default(now())

  @@index([resellerId, createdAt])
  @@index([orderId])
}

/// Règlement périodique entre ticketick et un revendeur.
model ResellerSettlement {
  id         String   @id @default(cuid())
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  resellerId String

  periodStart DateTime
  periodEnd   DateTime
  /// Même convention de signe que le grand livre.
  amountCents Int
  status      SettlementStatus @default(PENDING)
  reference   String?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resellerId, periodEnd])
}

/// Rabais. `code` renseigné = code promo à saisir ; `code` nul = rabais
/// automatique appliqué dès que les conditions sont réunies.
model Discount {
  id    String  @id @default(cuid())
  code  String? @unique
  label Json // { fr, en, de, it }

  type  DiscountType
  /// Pourcentage en points de base (1000 = 10 %) ou montant fixe en centimes,
  /// selon `type`.
  value Int

  scope DiscountScope @default(ORDER)

  /// Rabais automatique propre à un organisateur.
  organizer           Organizer? @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId         String?
  /// Ne compte et ne réduit que les séances de ce lieu.
  venue               Venue?     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId             String?
  /// Nombre de séances payantes distinctes requis dans la commande.
  minDistinctSessions Int?

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String?

  session   EventSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String?

  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  ticketTypeId String?

  /// Conditions d'application
  minQuantity    Int?
  minAmountCents Int?
  validFrom      DateTime?
  validUntil     DateTime?
  maxRedemptions Int?
  redemptions    Int       @default(0)

  active Boolean @default(true)

  orders OrderDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([sessionId])
  @@index([organizerId])
}

model OrderDiscount {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  discount    Discount @relation(fields: [discountId], references: [id])
  discountId  String
  /// Montant réellement déduit, figé au moment de la commande.
  amountCents Int

  @@unique([orderId, discountId])
}

model Order {
  id        String @id @default(cuid())
  reference String @unique

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  email      String
  firstName  String
  lastName   String
  phone      String?
  locale     String  @default("fr")
  /// Mention imprimée sur chaque billet (« Réservation Illyria »).
  ticketNote String?

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  /// Empreinte SHA-256 du jeton remis au seul navigateur qui a ouvert la
  /// rétention. La référence circule (communication du virement) : elle ne
  /// suffit pas à reprendre ni à annuler une commande.
  holdTokenHash String?

  /// Attribution de la vente
  channel         SalesChannel @default(ONLINE)
  reseller        Reseller?    @relation(fields: [resellerId], references: [id])
  resellerId      String?
  /// Agent du point de vente ayant saisi la commande.
  soldBy          User?        @relation("OrderSoldBy", fields: [soldByUserId], references: [id])
  soldByUserId    String?
  /// Commission due au revendeur sur cette commande, figée à la vente.
  commissionCents Int          @default(0)

  subtotalCents Int
  discountCents Int    @default(0)
  feeCents      Int    @default(0)
  totalCents    Int
  currency      String @default("CHF")

  items     OrderItem[]
  discounts OrderDiscount[]
  options   OrderOption[]
  tickets   Ticket[]
  payment   Payment?
  charges   OrderCharge[]
  ledger    ResellerLedgerEntry[]
  seats     SessionSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([resellerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String     @id @default(cuid())
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  ticketType     TicketType @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId   String
  quantity       Int
  unitPriceCents Int
  /// Séance numérotée : sièges retenus, un par billet.
  seatKeys       String[]   @default([])

  @@index([orderId])
}

/// Option proposée sur le formulaire d'achat (navette, repas, don…).
///
/// Activable par spectacle, éventuellement limitée à une séance. Un prix à
/// zéro reste une option gratuite : le montant n'est appliqué que s'il est
/// strictement positif.
model EventOption {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// Absente : l'option s'affiche pour toutes les séances du spectacle.
  session   EventSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String?

  enabled     Boolean              @default(false)
  title       Json
  hint        Json?
  /// Libellé imprimé sur le billet. Absent : on reprend le titre d'achat.
  ticketTitle Json?
  priceCents  Int                  @default(0)
  priceMode   EventOptionPriceMode @default(FLAT)
  sortOrder   Int                  @default(0)

  groups EventOptionGroup[]
  orders OrderOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, enabled])
  @@index([sessionId])
}

model EventOptionGroup {
  id       String      @id @default(cuid())
  option   EventOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId String

  title     Json
  required  Boolean             @default(false)
  sortOrder Int                 @default(0)
  choices   EventOptionChoice[]

  @@index([optionId])
}

model EventOptionChoice {
  id      String           @id @default(cuid())
  group   EventOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  label     Json
  sortOrder Int  @default(0)

  @@index([groupId])
}

/// Choix figé au moment de la commande : le catalogue peut encore changer.
model OrderOption {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  option   EventOption @relation(fields: [optionId], references: [id])
  optionId String

  title          String
  summary        String
  quantity       Int
  unitPriceCents Int
  amountCents    Int

  @@index([orderId])
}

model Ticket {
  id                String       @id @default(cuid())
  code              String       @unique
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  ticketType        TicketType   @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId      String
  attendeeName      String?
  /// Exigée par les gratuités d'âge ; montrée au contrôle d'entrée.
  attendeeBirthDate DateTime?    @db.Date
  seatKey           String?
  seatLabel         String?
  status            TicketStatus @default(VALID)
  usedAt            DateTime?
  createdAt         DateTime     @default(now())

  @@index([orderId])
  @@index([ticketTypeId])
}

model Payment {
  id          String        @id @default(cuid())
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String        @unique
  provider    String // "postfinance" | "stripe" | "paypal" | "iban" | "cash" | "free" | "mock"
  providerRef String? // id de transaction PostFinance ou session Stripe
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int
  currency    String        @default("CHF")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum ChargeKind {
  /// Places ajoutées : le client doit la différence.
  PAYMENT
  /// Places retirées : l'organisateur rend la différence.
  REFUND
}

enum ChargeMethod {
  /// Espèces, encaissées ou rendues de la main à la main.
  CASH
  /// Lien de paiement par carte envoyé au client, valable jusqu'à l'échéance.
  LINK
  /// Payé le soir du spectacle ; l'organisateur imprime et remet les billets.
  DOOR
  /// Note de crédit : l'organisateur rembourse par virement.
  CREDIT_NOTE
  /// Remboursé chez le prestataire du paiement d'origine (PostFinance, PayPal, Stripe).
  PROVIDER
  /// Carte passée sur le terminal du point de vente, qui garde l'argent comme des espèces.
  TERMINAL
  /// Virement reçu par l'organisateur sur son propre compte, hors ticketick.
  TRANSFER
}

enum ChargeStatus {
  OPEN
  DONE
  /// Lien non payé à l'échéance : les places sont reparties.
  EXPIRED
  CANCELLED
  /// Refusé par le prestataire : à relancer ou à régler autrement.
  FAILED
}

/// Règlement d'une modification faite depuis l'admin. `Order.totalCents`
/// suit l'encaissé net : il ne bouge qu'au règlement effectif.
model OrderCharge {
  id          String       @id @default(cuid())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  /// Référence donnée au client et au prestataire : TT-ABCD-EFGH-2.
  number      String       @unique
  kind        ChargeKind
  method      ChargeMethod
  status      ChargeStatus @default(OPEN)
  amountCents Int
  currency    String       @default("CHF")
  /// Lien de paiement : passé ce délai, les places sont rendues.
  dueAt       DateTime?
  /// Empreinte SHA-256 du jeton du lien : le lien seul ouvre le paiement.
  tokenHash   String?      @unique
  provider    String?
  providerRef String?
  /// Billets ajoutés ou retirés par ce règlement.
  ticketIds   String[]     @default([])
  /// Places prises sur les invitations : y retournent si le lien expire.
  fromInvites Boolean      @default(false)
  createdById String?
  createdAt   DateTime     @default(now())
  settledAt   DateTime?

  @@index([orderId])
  @@index([status, dueAt])
  @@index([provider, providerRef])
}

/// Reprises de données déjà passées (scripts lancés à chaque déploiement) :
/// une étape n'est jouée qu'une fois, même si l'admin a supprimé ce qu'elle
/// avait créé.
model SetupStep {
  key    String   @id
  doneAt DateTime @default(now())
}
